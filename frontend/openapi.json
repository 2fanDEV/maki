{
  "openapi": "3.1.0",
  "info": {
    "title": "Maki API",
    "version": "0.1.0"
  },
  "paths": {
    "/documents": {
      "post": {
        "summary": "Upload a document to an account-regional S3 bucket.",
        "operationId": "upload_document",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadDocumentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadDocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/labels": {
      "post": {
        "summary": "Create a label with a MongoDB-generated ID. Duplicate names are allowed.",
        "operationId": "create_label",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabelInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/labels/{id}": {
      "delete": {
        "summary": "Delete a label. Document/trainer reference checks are not implemented.",
        "operationId": "delete_label",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabelResponse"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/models/{model_id}": {
      "get": {
        "summary": "Read completed model metadata and evaluation. Resolve current label names through /labels.",
        "operationId": "model_metadata",
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelMetadata"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/trainers": {
      "post": {
        "summary": "Validate label IDs and store an untrained trainer in memory. Does not fit a model.",
        "operationId": "create_trainer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTrainerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainerMetadata"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/trainers/{trainer_id}": {
      "get": {
        "summary": "Read trainer configuration, lifecycle state, error, or resulting model ID.",
        "operationId": "trainer_metadata",
        "parameters": [
          {
            "name": "trainer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainerMetadata"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/trainers/{trainer_id}/train": {
      "post": {
        "summary": "Train and evaluate once, awaiting completion. Returns a new model ID. Disconnecting does not cancel training.",
        "operationId": "train_model",
        "parameters": [
          {
            "name": "trainer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelMetadata"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClassifierType": {
        "type": "string",
        "description": "Supported model types. Add variants and their training dispatch together.",
        "enum": [
          "nearest_centroid"
        ]
      },
      "CreateTrainerRequest": {
        "type": "object",
        "required": [
          "classifier",
          "documents"
        ],
        "properties": {
          "classifier": {
            "$ref": "#/components/schemas/ClassifierType"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingDocument"
            }
          },
          "evaluation_strategy": {
            "$ref": "#/components/schemas/EvaluationStrategy"
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Random seed for reproducible splits. Generated and returned when omitted.",
            "minimum": 0
          },
          "split": {
            "$ref": "#/components/schemas/SplitSettings"
          },
          "tf_idf": {
            "$ref": "#/components/schemas/TfIdfSettings"
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "EvaluationReport": {
        "type": "object",
        "required": [
          "strategy",
          "seed",
          "score_usage",
          "selected_split",
          "splits",
          "train_summary",
          "test_summary",
          "gap_summary"
        ],
        "properties": {
          "gap_summary": {
            "$ref": "#/components/schemas/MetricSummary"
          },
          "score_usage": {
            "type": "string"
          },
          "seed": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "selected_split": {
            "type": "integer",
            "minimum": 0
          },
          "splits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SplitEvaluation"
            }
          },
          "strategy": {
            "$ref": "#/components/schemas/EvaluationStrategy"
          },
          "test_summary": {
            "$ref": "#/components/schemas/MetricSummary"
          },
          "train_summary": {
            "$ref": "#/components/schemas/MetricSummary"
          }
        }
      },
      "EvaluationStrategy": {
        "type": "string",
        "enum": [
          "macro_f1",
          "balanced_accuracy",
          "matthews_correlation"
        ]
      },
      "IdfWeightScheme": {
        "type": "string",
        "enum": [
          "base",
          "smooth",
          "maximum",
          "probabilistic"
        ]
      },
      "LabelInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LabelResponse": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "MetricSummary": {
        "type": "object",
        "required": [
          "mean",
          "standard_deviation"
        ],
        "properties": {
          "mean": {
            "$ref": "#/components/schemas/Metrics"
          },
          "standard_deviation": {
            "$ref": "#/components/schemas/Metrics",
            "description": "Population standard deviation across the observed splits."
          }
        }
      },
      "Metrics": {
        "type": "object",
        "required": [
          "macro_f1",
          "balanced_accuracy",
          "matthews_correlation"
        ],
        "properties": {
          "balanced_accuracy": {
            "type": "number",
            "format": "double"
          },
          "macro_f1": {
            "type": "number",
            "format": "double"
          },
          "matthews_correlation": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ModelMetadata": {
        "type": "object",
        "required": [
          "model_id",
          "trainer_id",
          "classifier",
          "seed",
          "label_ids",
          "feature_count",
          "split",
          "tf_idf",
          "evaluation"
        ],
        "properties": {
          "classifier": {
            "$ref": "#/components/schemas/ClassifierType"
          },
          "evaluation": {
            "$ref": "#/components/schemas/EvaluationReport"
          },
          "feature_count": {
            "type": "integer",
            "minimum": 0
          },
          "label_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_id": {
            "type": "string",
            "format": "uuid"
          },
          "seed": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "split": {
            "$ref": "#/components/schemas/SplitSettings"
          },
          "tf_idf": {
            "$ref": "#/components/schemas/TfIdfSettings"
          },
          "trainer_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SamplingStrategy": {
        "type": "string",
        "enum": [
          "random",
          "stratified"
        ]
      },
      "SplitEvaluation": {
        "type": "object",
        "required": [
          "split_index",
          "train_samples",
          "test_samples",
          "train",
          "test",
          "gap"
        ],
        "properties": {
          "gap": {
            "$ref": "#/components/schemas/Metrics"
          },
          "split_index": {
            "type": "integer",
            "minimum": 0
          },
          "test": {
            "$ref": "#/components/schemas/Metrics"
          },
          "test_samples": {
            "type": "integer",
            "minimum": 0
          },
          "train": {
            "$ref": "#/components/schemas/Metrics"
          },
          "train_samples": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SplitSettings": {
        "type": "object",
        "properties": {
          "ratio": {
            "type": "number",
            "format": "float",
            "description": "Training fraction, strictly between zero and one.",
            "default": 0.800000011920929
          },
          "repetitions": {
            "type": "integer",
            "description": "Number of train/test splits; must be at least one.",
            "default": 5,
            "minimum": 0
          },
          "sampling": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SamplingStrategy"
              }
            ],
            "default": "stratified"
          }
        },
        "additionalProperties": false
      },
      "TfIdfSettings": {
        "type": "object",
        "properties": {
          "double_normalization_k": {
            "type": "number",
            "format": "double",
            "default": 0.5
          },
          "idf_scheme": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/IdfWeightScheme"
              }
            ],
            "default": "base"
          },
          "tf_scheme": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TfWeightScheme"
              }
            ],
            "default": "raw_count"
          }
        },
        "additionalProperties": false
      },
      "TfWeightScheme": {
        "type": "string",
        "enum": [
          "binary",
          "raw_count",
          "normalization",
          "double_normalization_half",
          "double_normalization_variable"
        ]
      },
      "TrainerMetadata": {
        "type": "object",
        "required": [
          "trainer_id",
          "classifier",
          "seed",
          "label_ids",
          "split",
          "tf_idf",
          "evaluation_strategy",
          "status"
        ],
        "properties": {
          "classifier": {
            "$ref": "#/components/schemas/ClassifierType"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "evaluation_strategy": {
            "$ref": "#/components/schemas/EvaluationStrategy"
          },
          "label_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "seed": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "split": {
            "$ref": "#/components/schemas/SplitSettings"
          },
          "status": {
            "$ref": "#/components/schemas/TrainerStatus"
          },
          "tf_idf": {
            "$ref": "#/components/schemas/TfIdfSettings"
          },
          "trainer_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TrainerStatus": {
        "type": "string",
        "enum": [
          "created",
          "training",
          "completed",
          "failed"
        ]
      },
      "TrainingDocument": {
        "type": "object",
        "required": [
          "name",
          "pages",
          "label_id"
        ],
        "properties": {
          "label_id": {
            "type": "string",
            "description": "Hexadecimal MongoDB label ID. Each class needs at least two documents."
          },
          "name": {
            "type": "string"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "UploadDocumentRequest": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "bucket_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "type": "string",
            "format": "binary"
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "UploadDocumentResponse": {
        "type": "object",
        "required": [
          "bucket_name",
          "e_tag",
          "object_key"
        ],
        "properties": {
          "bucket_name": {
            "type": "string"
          },
          "e_tag": {
            "type": [
              "string",
              "null"
            ]
          },
          "object_key": {
            "type": "string"
          }
        }
      }
    }
  }
}
