---
import { ClientRouter } from 'astro:transitions';
import { DashboardSidebar } from '@/components/dashboard/DashboardSidebar';
import { DashboardTopbar } from '@/components/dashboard/DashboardTopbar';
import { boards, type BoardId } from '@/lib/boards';
import { DEFAULT_WIDTH, MAXIMUM_WIDTH, MINIMUM_WIDTH, SIDEBAR_COOKIE, WIDTH_COOKIE, SidebarState } from '@/state/zustand';
import '@/styles/global.css';
import '@/styles/dashboard.css';

type Props = {
  activeBoard: BoardId;
};

const { activeBoard } = Astro.props;
const currentBoard = boards.find((board) => board.id === activeBoard);

if (!currentBoard) {
  throw new Error(`Unknown dashboard board: ${activeBoard}`);
}

const savedSidebar = Astro.cookies.get(SIDEBAR_COOKIE)?.value;
const savedWidth = Number(Astro.cookies.get(WIDTH_COOKIE)?.value);
const initialState = {
  sidebar: savedSidebar === SidebarState.CLOSED ? SidebarState.CLOSED : SidebarState.OPENED,
  width: Number.isFinite(savedWidth) && savedWidth >= MINIMUM_WIDTH && savedWidth <= MAXIMUM_WIDTH
    ? savedWidth
    : DEFAULT_WIDTH,
};
Astro.response.headers.set('Cache-Control', 'private, no-store');

---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>{currentBoard.name} | Maki</title>
    <script is:inline>
      // Apply before first paint, while the bundled store script is still loading.
      (() => {
        let dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        try {
          const theme = localStorage.getItem('maki-theme');
          if (theme === 'light' || theme === 'dark') dark = theme === 'dark';
        } catch {
          // Use the system preference when storage is unavailable.
        }
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <script>
      import { Theme, useThemeStore } from '@/state/zustand';

      useThemeStore.getState().initTheme();

      function applyTheme(root = document.documentElement) {
        root.classList.toggle('dark', useThemeStore.getState().resolvedTheme === Theme.DARK);
      }

      applyTheme();
      useThemeStore.subscribe(() => applyTheme());
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', ({ matches }) => {
        if (useThemeStore.getState().theme === Theme.SYSTEM) {
          useThemeStore.setState({ resolvedTheme: matches ? Theme.DARK : Theme.LIGHT });
        }
      });
      document.addEventListener('astro:before-swap', (event) => {
        applyTheme(event.newDocument.documentElement);
      });
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="dashboard-layout">
      <DashboardSidebar
        activeBoard={activeBoard}
        initialState={initialState}
        client:load
        transition:persist="dashboard-sidebar"
      />
      <div class="dashboard-content">
        <DashboardTopbar client:load transition:persist="dashboard-topbar" />
        <main class="dashboard-main">
          <section class="board" aria-labelledby={`board-title-${activeBoard}`}>
            <slot />
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
